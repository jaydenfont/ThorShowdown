<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API 30 and below. See data_extraction_rules.xml for API 31+. -->
<full-backup-content>
    <!-- The saved login's password is encrypted with a Keystore key that is never backed up,
         so a restored copy could never be decrypted. -->
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
</full-backup-content>
