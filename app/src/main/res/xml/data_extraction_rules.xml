<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for API 31+. -->
<data-extraction-rules>
    <!-- The saved login's password is encrypted with a Keystore key that never leaves the device,
         so a restored or transferred copy could never be decrypted. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
